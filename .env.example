# Telegram Bot
BOT_TOKEN=
ID=
HASH=

# Администраторы (Telegram user ID через запятую)
ADMIN_USER_IDS=123456789

# AI
GROQ_API_KEY=
OPENROUTER_API_KEY=
POLZA_AI_API_KEY=

# Proxy (опционально)
PROXY_USER=
PROXY_PASSWORD=
PROXY_IP=
PROXY_PORT=

# Web
PORT=8000
WEBAPP_URL=
CORS_ORIGINS=

# Telegram updates: polling (dev) или webhook (prod с HTTPS)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Redis (обязателен для устойчивого отслеживания в Docker)
REDIS_URL=redis://redis:6379/0

# Logging (structlog, как в bedolaga)
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_DIR=logs
LOG_COLORS=true
LOG_ROTATION_ENABLED=false
TIMEZONE=UTC

# Dev (только локальная разработка)
ENABLE_MOCK_AUTH=false
