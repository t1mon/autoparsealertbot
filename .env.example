# Telegram Bot
BOT_TOKEN=
ID=
HASH=

# Администраторы (Telegram user ID через запятую)
ADMIN_USER_IDS=123456789

# Закрытая бета: true = только ALLOWED_USER_IDS (по умолчанию = ADMIN_USER_IDS)
CLOSED_BETA=true
# ALLOWED_USER_IDS=123,456
DEVELOPER_USERNAME=cheef_engineer

# AI (бесплатный ключ Groq для тестов: https://console.groq.com/keys )
GROQ_API_KEY=
OPENROUTER_API_KEY=
POLZA_AI_API_KEY=

# Proxy (опционально; если пусто — прокси не используется)
PROXY_USER=
PROXY_PASSWORD=
PROXY_IP=
PROXY_PORT=

# Web
PORT=8000
WEBAPP_URL=
CORS_ORIGINS=

# Telegram updates: polling (dev) или webhook (prod с HTTPS)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Redis (обязателен для устойчивого отслеживания в Docker)
REDIS_URL=redis://redis:6379/0
# Дедуп алертов в Redis (секунды, по умолчанию 7 дней)
ALERT_DEDUP_TTL_SECONDS=604800
# Игнор канала из алерта (секунды, по умолчанию 24 часа)
CHANNEL_MUTE_TTL_SECONDS=86400

# Антибан при массовых JoinChannel
# Пауза после успешного вступления (сек)
JOIN_DELAY_MIN=20
JOIN_DELAY_MAX=45
# Пауза после ошибки (сек; already — без паузы)
JOIN_ERROR_DELAY_MIN=10
JOIN_ERROR_DELAY_MAX=25
# Лимит новых вступлений за один проход / за сутки (UTC)
JOIN_BATCH_LIMIT=40
JOIN_DAILY_LIMIT=80
# Промежуточные уведомления «подписался»: каждые N новых (0 = только итог)
JOIN_NOTIFY_EVERY=5

# Logging (structlog, как в bedolaga)
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_DIR=logs
LOG_COLORS=true
LOG_ROTATION_ENABLED=false
TIMEZONE=UTC

# Dev (только локальная разработка)
ENABLE_MOCK_AUTH=false
